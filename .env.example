# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Required. Production refuses to start without it, because anyone who knows the key can
# forge a session cookie claiming role=admin. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional. An IANA zone name. The container's clock is UTC, so without this the recorded
# times are UTC and will disagree with a register kept in local time.
# TIMEZONE=Europe/London

# Optional. 1 for a shared door camera, 0 for personal check-in.
# KIOSK_MODE=1

# Optional. Comma-separated CIDR networks that /recognize will accept a frame from, e.g.
# 10.0.0.0/8,192.168.1.0/24. Unset means no restriction. Mostly for KIOSK_MODE=0, where a
# signed-in person can otherwise check themselves in from anywhere. Requires
# TRUSTED_PROXY_HOPS to be correct, and a typo here stops the app rather than silently
# removing the restriction.
# CHECKIN_NETWORKS=
